{
  "name": "irish-grammar-checker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later AND ODbL-1.0",
  "description": "Irish grammar checker that runs in the browser: a TypeScript port of An Gramadoir",
  "repository": "github:liamosaur/irish-grammar-checker",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compare": "node tools/compare.ts",
    "test": "node --test test/*.test.ts",
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8"
  }
}
