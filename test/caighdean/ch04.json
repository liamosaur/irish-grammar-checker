  {"section":"4.8.1","page":66,"text":"Faigh an luach is airde air."},
  {"section":"4.8.1","page":66,"text":"Is í Ciara an cailín is dathúla sa rang."},
  {"section":"4.8.1","page":66,"text":"An rud is deacra faoin bhfilíocht, a léamh mar is cóir."},
  {"section":"4.8.1","page":66,"text":"Is iadsan na daoine is imníche sa tír."},
  {"section":"4.8.1","page":66,"text":"Is eisean is taithíche ar an obair seo."},
  {"section":"4.8.1","page":66,"text":"Cuirfear an córas is uathoibríche i bhfeidhm."},
  {"section":"4.8.2","page":66,"text":"Is é Rónán an duine is fearr sa rang."},
  {"section":"4.8.2","page":66,"text":"Is í an chuimhne is faide siar i mo cheann í."},
  {"section":"4.8.2","page":66,"text":"Is í an chuimhne is sia siar i mo cheann í.","variant":true},
  {"section":"4.8.2","page":66,"text":"Cé acu ceann is mó?"},
  {"section":"4.8.3","page":66,"text":"B’aoibhinn liom a áille a labhair sí."},
  {"section":"4.8.3","page":66,"text":"B’aoibhinn liom a bhinne a labhair sí.","variant":true},
  {"section":"4.8.3","page":66,"text":"B’aoibhinn liom a chruinne a labhair sí.","variant":true},
  {"section":"4.8.3","page":66,"text":"B’aoibhinn liom a líofa a labhair sí.","variant":true},
  {"section":"4.8.3","page":66,"text":"B’aoibhinn liom a réidhe a labhair sí.","variant":true},
  {"section":"4.8.3","page":66,"text":"B’aoibhinn liom a shoiléire a labhair sí.","variant":true},
  {"section":"4.8.3","page":66,"text":"Ní chreidfeá a achrannaí a bhí an áit."},
  {"section":"4.8.3","page":66,"text":"Ní chreidfeá a dhonacht a bhí an áit.","variant":true},
  {"section":"4.8.3","page":66,"text":"Ní chreidfeá a olcas a bhí an áit.","variant":true},
  {"section":"4.8.3","page":66,"text":"Ní chreidfeá a shleamhaine a bhí an áit.","variant":true},
  {"section":"4.8.3","page":66,"text":"Ní chreidfeá a uaigní a bhí an áit.","variant":true},
  {"section":"4.8.3","page":66,"text":"Fuair sé ardmholadh trína fheabhas a rinne sé an obair."},
  {"section":"4.8.3","page":66,"text":"Dá chríonna é, níor éirigh an gnó leis."},
  {"section":"4.8.3","page":66,"text":"Dá chróga é, níor éirigh an gnó leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá fheabhas é, níor éirigh an gnó leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá ghlice é, níor éirigh an gnó leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá oilte é, níor éirigh an gnó leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá dhonacht é, caithfear glacadh leis."},
  {"section":"4.8.3","page":66,"text":"Dá ghránna é, caithfear glacadh leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá leisciúla é, caithfear glacadh leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá olcas é, caithfear glacadh leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá shuaraí é, caithfear glacadh leis.","variant":true},
  {"section":"4.8.3","page":66,"text":"Dá mhéad dúil a bhí aici ann, níor cheannaigh sí sa deireadh é."},
  {"section":"4.8.3","page":66,"text":"dá mhéad airgead a bhí aici","phrase":true},
  {"section":"4.8.3","page":66,"text":"a mhéid is indéanta le réasún","phrase":true},
  {"section":"4.8.3","page":66,"text":"a mhéid is gá","phrase":true},
  {"section":"4.10","page":67,"text":"Tá an fear seo tinn."},
  {"section":"4.10","page":67,"text":"Beidh an buachaill seo ag teacht liom."},
  {"section":"4.10","page":67,"text":"Is liomsa iad seo."},
  {"section":"4.10","page":67,"text":"Níl an doras sin dúnta."},
  {"section":"4.10","page":67,"text":"Síle is ainm don chailín sin."},
  {"section":"4.10","page":67,"text":"Díoladh a theach siúd inné."},
  {"section":"4.10","page":67,"text":"Is aige siúd a bhí an t-airgead."},
  {"section":"4.10","page":67,"text":"An bhfeiceann tú an pháirc úd thall?"},
  {"section":"4.11","page":67,"text":"Bhí an traein folamh."},
  {"section":"4.11","page":67,"text":"Bíonn na busanna déanach."},
  {"section":"4.11","page":67,"text":"An bhfuil an bhean sin saibhir?"},
  {"section":"4.11","page":67,"text":"Beidh an bhainis sin mór."},
  {"section":"4.11","page":67,"text":"Nach deas é?","phrase":true},
  {"section":"4.11","page":67,"text":"Tá an aimsir fuar.","phrase":true},
  {"section":"4.12.1","page":67,"text":"Is bean phósta í","phrase":true},
  {"section":"4.12.1","page":67,"text":"Ní briste atá sé","phrase":true},
  {"section":"4.12.1","page":67,"text":"Is í atá tugtha don obair","phrase":true},
  {"section":"4.12.1","page":67,"text":"Táimid beirthe go maith leis an socrú sin.","phrase":true}
]
