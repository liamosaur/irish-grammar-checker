  {"section":"Tábla 6A","page":110,"text":"Tá sé ag dul suas an staighre."},
  {"section":"Tábla 6A","page":110,"text":"Tá sé thuas staighre."},
  {"section":"Tábla 6A","page":110,"text":"Tá sé ag teacht anuas an staighre."},
  {"section":"Tábla 6A","page":110,"text":"Tá sí ag dul síos an staighre."},
  {"section":"Tábla 6A","page":110,"text":"Tá sí thíos staighre."},
  {"section":"Tábla 6A","page":110,"text":"Tá sí ag teacht aníos an staighre."},
  {"section":"Tábla 6A","page":110,"text":"An bhfuil tú ag dul amach don oíche?"},
  {"section":"Tábla 6A","page":110,"text":"Táim amuigh."},
  {"section":"Tábla 6A","page":110,"text":"Tá sí ag teacht amach chomh fada leat."},
  {"section":"Tábla 6A","page":110,"text":"An bhfuil tú ag dul isteach sa teach?"},
  {"section":"Tábla 6A","page":110,"text":"Is istigh sa teach a tharla an timpiste."},
  {"section":"Tábla 6A","page":110,"text":"Tar isteach chugam!"},
