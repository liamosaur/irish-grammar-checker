  {"section":"6.1.1(f)","page":108,"text":"Tá Seán níos airde ná Máire."},
  {"section":"6.1.1(f)","page":108,"text":"Bhí siad ní ba ghile ná an sneachta."},
  {"section":"6.1.1(f)","page":108,"text":"Ba ghá dóibh dréimire níos fearr a fháil anuraidh."},
  {"section":"6.1.1(f)","page":108,"text":"Ba ghá dóibh dréimire ní b’fhearr a fháil anuraidh.","variant":true},
  {"section":"6.1.1(f)","page":108,"text":"Dá mbeinn bliain níos óige, d’imreoinn an cluiche."},
  {"section":"6.1.1(f)","page":108,"text":"Dá mbeinn bliain ní b’óige, d’imreoinn an cluiche.","variant":true},
  {"section":"6.1.1(f)","page":108,"text":"Bhí na braillíní níos gile ná an sneachta."},
  {"section":"6.1.1(f)","page":108,"text":"Bhí na braillíní ní ba ghile ná an sneachta.","variant":true},
  {"section":"6.1.1(g)","page":108,"text":"féin","phrase":true},
  {"section":"6.1.1(g)","page":108,"text":"Má bhí sé tuirseach féin, chuaigh sé chuig an Oireachtas."},
  {"section":"6.1.1(g)","page":108,"text":"Is ócáid thábhachtach í; beidh an tUachtarán féin ann."},
  {"section":"6.1.1(h)","page":108,"text":"ar leithead","phrase":true},
  {"section":"6.1.1(h)","page":108,"text":"Bhí an seomra suite sé mhéadar ar fad."},
  {"section":"6.1.1(h)","page":108,"text":"Tá an bóithrín trí mhéadar ar leithead."},
  {"section":"6.1.1(i)","page":108,"text":"gann","phrase":true},
  {"section":"6.1.1(i)","page":108,"text":"gearr","phrase":true},
  {"section":"6.1.1(i)","page":108,"text":"Bhí siad duine gearr."},
  {"section":"6.1.1(i)","page":108,"text":"Bhí muid gann i mbainne."},
  {"section":"6.1.1(j)","page":108,"text":"aniar","phrase":true},
  {"section":"6.1.1(j)","page":108,"text":"anuas","phrase":true},
  {"section":"6.1.1(j)","page":108,"text":"An bhfeiceann tú an fear amach?"},
  {"section":"6.1.1(j)","page":108,"text":"Seo chugainn an bhean isteach."},
  {"section":"6.1.1(j)","page":108,"text":"Tá an bhean aniar ar an teilifís."},
  {"section":"6.1.1(j)","page":108,"text":"Tá braon anuas sa seomra codlata."},
  {"section":"6.1.1(j)","page":108,"text":"Is é Tomás an cliamhain isteach."},
  {"section":"6.1.1(j)","page":108,"text":"Tá an ghaoth anoir is an fhearthainn aniar air."},
  {"section":"6.1.1(k)","page":108,"text":"ganfhiosaíocht","phrase":true},
  {"section":"6.1.1(k)","page":108,"text":"istoícheadóireacht","phrase":true},
  {"section":"6.1.1(k)","page":108,"text":"Tá an bleachtaire ag ganfhiosaíocht ar gach duine."},
  {"section":"6.1.1(k)","page":108,"text":"Tá an iomarca istoícheadóireachta ar siúl san áit seo."},
  {"section":"6.2","page":109,"text":"go cúramach","phrase":true},
  {"section":"6.2","page":109,"text":"Tiomáin níos cúramaí amach anseo."},
  {"section":"6.2","page":109,"text":"Labhair níos airde feasta."},
  {"section":"6.2","page":109,"text":"Níor scrúdaíodh an córas minic go leor."},
  {"section":"6.2","page":109,"text":"go sciobtha","phrase":true},
  {"section":"6.2","page":109,"text":"Thiomáin sé sciobtha go maith."},
  {"section":"6.2","page":109,"text":"go réidh","phrase":true},
  {"section":"6.2","page":109,"text":"Déan go deas réidh anois é."},
  {"section":"6.2","page":109,"text":"go flaithiúil","phrase":true},
  {"section":"6.2","page":109,"text":"Roinneadh an bia go fial flaithiúil."},
  {"section":"6.2","page":109,"text":"go dian","phrase":true},
  {"section":"6.2","page":109,"text":"D’oibrigh sé cuibheasach dian."},
  {"section":"6.2","page":109,"text":"go maith","phrase":true},
  {"section":"6.2","page":109,"text":"D’imir sí sách maith."},
