  {"section":"Tábla 6B","page":110,"text":"Rachaimid ó thuaidh amárach."},
  {"section":"Tábla 6B","page":110,"text":"Tá an siopa sin ar an taobh ó thuaidh den chontae."},
  {"section":"Tábla 6B","page":110,"text":"Tá an siopa sin ar an taobh thuaidh den chontae.","variant":true},
  {"section":"Tábla 6B","page":110,"text":"Tháinig siad aduaidh inné."},
  {"section":"Tábla 6B","page":110,"text":"D’imigh sé ó dheas ar maidin."},
  {"section":"Tábla 6B","page":110,"text":"Tá teach acu ar an gcósta ó dheas."},
  {"section":"Tábla 6B","page":110,"text":"Tá teach acu ar an gcósta theas.","variant":true},
  {"section":"Tábla 6B","page":110,"text":"Tá sí ag teacht aneas faoi láthair."},
  {"section":"Tábla 6B","page":110,"text":"An ndeachaigh tú soir chucu?"},
  {"section":"Tábla 6B","page":110,"text":"Chuaigh, ach ní raibh aon duine thoir."},
  {"section":"Tábla 6B","page":110,"text":"Bhí orm teacht anoir arís."},
  {"section":"Tábla 6B","page":110,"text":"An bhfuil tú ag dul siar anocht?"},
  {"section":"Tábla 6B","page":110,"text":"An raibh tú thiar aréir?"},
  {"section":"Tábla 6B","page":110,"text":"An mbeidh siad ag teacht aniar ar cuairt?"},
  {"section":"Tábla 6B","page":110,"text":"An ndeachaigh Áine sall go Sasana inné?"},
  {"section":"Tábla 6B","page":110,"text":"An ndeachaigh Áine anonn go Sasana inné?","variant":true},
  {"section":"Tábla 6B","page":110,"text":"Chuaigh, tá sí thall le seachtain."},
  {"section":"Tábla 6B","page":110,"text":"Cén uair a thiocfaidh sí anall arís?"},
