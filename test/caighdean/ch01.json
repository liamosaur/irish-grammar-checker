  {"section":"1.1.5(b)","page":1,"text":"an Roinn Oideachais agus Scileanna","phrase":true},
  {"section":"1.1.5(b)","page":1,"text":"an Oifig um Rialú Tobac","phrase":true},
  {"section":"1.1.5(b)","page":1,"text":"Feidhmeannacht na Seirbhíse Sláinte","phrase":true},
  {"section":"1.1.5(b)","page":1,"text":"an Phríomh-Oifig Staidrimh","phrase":true},
  {"section":"1.1.5(b)","page":1,"text":"Is san fhoirgneamh sin thall atá an Roinn Oideachais agus Scileanna."},
  {"section":"1.1.5(b)","page":1,"text":"Chuaigh Seán go dtí an Oifig um Rialú Tobac."},
  {"section":"1.1.5(b)","page":1,"text":"Tá Feidhmeannacht na Seirbhíse Sláinte an-ghnóthach."},
