  {"section":"1.1.5(d)","page":2,"text":"an Carghas","phrase":true},
  {"section":"1.1.5(d)","page":2,"text":"Tá an Nollaig ag teannadh linn."},
  {"section":"1.1.5(d)","page":2,"text":"Is i mí an Mhárta a bheidh an Cháisc i mbliana."},
  {"section":"1.1.5(d)","page":2,"text":"Rinne mé an Carghas ar an ól."},
