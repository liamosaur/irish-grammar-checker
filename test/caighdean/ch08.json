  {"section":"8.3.2","page":133,"text":"a cóta sise","phrase":true},
  {"section":"8.3.2","page":133,"text":"a dteach siadsan","phrase":true},
  {"section":"8.3.2","page":133,"text":"Ní raibh mórán i gceist lena mhodúil seisean."},
  {"section":"8.3.2","page":133,"text":"An bhfaca tú a carr sise?"},
  {"section":"8.3.2","page":133,"text":"Tá neart le déanamh ar a bhfeirm siadsan."},
