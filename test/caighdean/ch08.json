  {"section":"8.5.1","page":139,"text":"Cá bhfuil tú ag dul?"},
  {"section":"8.5.1","page":139,"text":"Cá ndeachaigh sé ar maidin?"},
  {"section":"8.5.1","page":139,"text":"Cad as duit?"},
  {"section":"8.5.1","page":139,"text":"Cad mar gheall ar an gceann seo?"},
  {"section":"8.5.1","page":139,"text":"Cé atá ag teacht?"},
  {"section":"8.5.1","page":139,"text":"Cé na ceisteanna atá agat?"},
  {"section":"8.5.1","page":139,"text":"Céard a tharla aréir?"},
  {"section":"8.5.1","page":139,"text":"Céard a rinne siad tar éis na hoibre?"},
  {"section":"8.5.2","page":139,"text":"Cá háit a ndeachaigh siad?"},
  {"section":"8.5.2","page":139,"text":"Cá huair a bheidh tú ag filleadh?"},
  {"section":"8.5.2","page":139,"text":"Cá hiontas?"},
  {"section":"8.5.2","page":139,"text":"Cá haois é?"},
  {"section":"8.5.3","page":139,"text":"Cé hé an fear sin?"},
  {"section":"8.5.3","page":139,"text":"Cé hí féin?"},
  {"section":"8.5.3","page":139,"text":"Cé hiad na saineolaithe?"},
  {"section":"8.5.3","page":139,"text":"Cé hiadsan?"},
  {"section":"8.5.4","page":139,"text":"Cár chuir tú é?"},
  {"section":"8.5.4","page":139,"text":"Cárb as thú?"},
  {"section":"8.5.4","page":139,"text":"Cárbh ard é?"},
  {"section":"8.5.4","page":139,"text":"Cér de é?"},
  {"section":"8.5.4","page":139,"text":"Cér díobh é?"},
  {"section":"8.5.4","page":139,"text":"Cérb é sin?"},
  {"section":"8.5.4","page":139,"text":"Cérbh iad na cuairteoirí?"},
  {"section":"8.5.4","page":139,"text":"Cén t-achar anseo tú?"},
  {"section":"8.5.4","page":139,"text":"Cén dochar é?"},
  {"section":"8.5.5","page":140,"text":"Cé leis a raibh tú ag caint?"},
  {"section":"8.5.5","page":140,"text":"Cé ina aghaidh a raibh siad ag imirt?"},
  {"section":"8.5.5","page":140,"text":"Cad é a chuir tú ann?"},
  {"section":"8.5.5","page":140,"text":"Cé aige a bhfuil na ticéid?"},
  {"section":"8.5.5","page":140,"text":"Céard faoi a bhfuil sibh ag caint?"},
  {"section":"8.6.1","page":140,"text":"Is bronntanas é sin","phrase":true},
  {"section":"8.6.1","page":140,"text":"Tabhair cabhair dóibh seo","phrase":true},
  {"section":"8.6.1","page":140,"text":"Cá bhfuil a cóipleabhar siúd?","phrase":true},
  {"section":"8.6.1","page":140,"text":"dá rachaidís siúd","phrase":true},
  {"section":"8.6.1","page":140,"text":"Sin é an bronntanas","phrase":true},
  {"section":"8.6.1","page":140,"text":"Seo é an cóipleabhar","phrase":true},
  {"section":"8.6.1","page":140,"text":"Siúd iad na múinteoirí","phrase":true},
  {"section":"8.6.1","page":140,"text":"Siúd í an traein chugainn","phrase":true},
  {"section":"8.6.1","page":140,"text":"Tá sin álainn","phrase":true},
  {"section":"8.6.1","page":140,"text":"Ith seo","phrase":true},
  {"section":"8.6.1","page":140,"text":"An bhfuil siúd amhlaidh?","phrase":true},
  {"section":"8.6.1","page":140,"text":"D’imigh siúd leis an mbus","phrase":true},
  {"section":"8.6.1","page":140,"text":"Sin madra","phrase":true},
  {"section":"8.6.1","page":140,"text":"Seo an mála","phrase":true},
  {"section":"8.6.1","page":140,"text":"Siúd an fhírinne","phrase":true},
  {"section":"8.6.1","page":140,"text":"Cad seo?","phrase":true},
  {"section":"8.6.1","page":140,"text":"Cé sin?","phrase":true},
  {"section":"8.6.1","page":140,"text":"Sin sin","phrase":true},
  {"section":"8.6.1","page":140,"text":"mar seo","phrase":true},
  {"section":"8.6.1","page":140,"text":"go dtí sin","phrase":true},
  {"section":"8.6.1","page":140,"text":"gan siúd a ól","phrase":true},
