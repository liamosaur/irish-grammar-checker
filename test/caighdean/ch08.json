[
  {"section":"8.2.2","page":131,"text":"aithním thú","phrase":true},
  {"section":"8.2.2","page":131,"text":"molaim thú","phrase":true},
  {"section":"8.2.2","page":131,"text":"Mo náire thú","phrase":true},
  {"section":"8.2.2","page":131,"text":"Is oibrí díograiseach thú","phrase":true},
  {"section":"8.2.2","page":131,"text":"Níor dhearmad sé thú riamh."},
  {"section":"8.2.2","page":131,"text":"An é sin an áit ar rugadh thú?"},
  {"section":"8.2.2","page":131,"text":"Thréig sí thú ar fhear eile."},
  {"section":"8.2.2","page":131,"text":"Ní aithnímse thusa."},
  {"section":"8.2.2","page":131,"text":"Chugam aniar thú!"},
  {"section":"8.2.2","page":131,"text":"Is fearrde thú an sos."},
  {"section":"8.2.3","page":131,"text":"An bhfaca tú clár na dtorthaí aréir?"},
  {"section":"8.2.3","page":131,"text":"Ní bheadh an bua againn gan tú."},
  {"section":"8.2.3","page":131,"text":"Is tusa an captaen."},
  {"section":"8.2.3","page":131,"text":"Tá tusa níos láidre ná eisean."},
  {"section":"8.2.3","page":131,"text":"Nach tusa an maor dóiteáin?"},
  {"section":"8.2.4","page":132,"text":"Tháinig sé isteach."},
  {"section":"8.2.4","page":132,"text":"Tháinig sí isteach.","variant":true},
  {"section":"8.2.4","page":132,"text":"Tháinig siad isteach.","variant":true},
  {"section":"8.2.4","page":132,"text":"Bíonn seisean déanach go minic."},
  {"section":"8.2.4","page":132,"text":"Bíonn sise déanach go minic.","variant":true},
  {"section":"8.2.4","page":132,"text":"Bíonn siadsan déanach go minic.","variant":true},
  {"section":"8.2.4","page":132,"text":"An ndearna sé an dinnéar?"},
  {"section":"8.2.4","page":132,"text":"An ndearna sí an dinnéar?","variant":true},
  {"section":"8.2.4","page":132,"text":"An ndearna siad an dinnéar?","variant":true},
  {"section":"8.2.5","page":132,"text":"Leag an ghaoth é."},
  {"section":"8.2.5","page":132,"text":"Is mar sin is fearr é."},
  {"section":"8.2.5","page":132,"text":"An é Micheál a chaill an t-airgead?"},
  {"section":"8.2.5","page":132,"text":"Níl san oifig inniu ach eisean."},
  {"section":"8.2.5","page":132,"text":"Chuaigh Tomás agus í ar saoire inné."},
  {"section":"8.2.5","page":132,"text":"Í a phógadh is ea a rinne sé."},
  {"section":"8.2.5","page":132,"text":"Cé hí féin?"},
  {"section":"8.2.5","page":132,"text":"Bhí buaite agam murach ise."},
  {"section":"8.2.5","page":132,"text":"An ndeachaigh sé amach chun iad a cheannach?"},
  {"section":"8.2.5","page":132,"text":"Ar deireadh thiar thall, fuair sé iad."},
  {"section":"8.2.5","page":132,"text":"Is cuimhin liom iadsan ag caint air."},
  {"section":"8.2.5","page":132,"text":"Iadsan a rinne é."},
  {"section":"8.2.6","page":132,"text":"is é mo thuairim","phrase":true},
  {"section":"8.2.6","page":132,"text":"is é an aidhm","phrase":true},
  {"section":"8.2.6","page":132,"text":"is é an bhrí","phrase":true},
  {"section":"8.2.6","page":132,"text":"is é mo bharúil","phrase":true},
  {"section":"8.2.6","page":132,"text":"Is é mo thuairimse gur fiú imeacht anois."},
  {"section":"8.2.6","page":132,"text":"Is é an aidhm atá leis líon na mac léinn a mhéadú."},
  {"section":"8.2.6","page":132,"text":"Is é an bhrí atá le “Coimisiún” an Coimisiún Eorpach."},
  {"section":"8.2.6","page":132,"text":"Is é mo bharúilse nár chóir dó éirí as."},
  {"section":"8.2.6","page":132,"text":"Is é an fhadhb go bhfuil sé ró-leisciúil.","known":"CAIGHDEAN: the morphology removes the hyphen (róleisciúil, as CO17 2.1.7 would have it); the book prints ró-leisciúil"},
  {"section":"8.2.7","page":132,"text":"Ar imigh sé gan sinn?"},
  {"section":"8.2.7","page":132,"text":"Níor bhuail mé riamh le daoine mar sibh."},
