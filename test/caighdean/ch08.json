  {"section":"8.3.4","page":135,"text":"Is é sin mo cheannsa."},
  {"section":"8.3.4","page":135,"text":"Cé acu ceann a ceannsa?"},
  {"section":"8.3.4","page":135,"text":"Cá bhfuil bhur gcuidse?"},
  {"section":"8.3.4","page":135,"text":"Ní bhfuair siad a gcuidsean."},
  {"section":"8.3.4","page":135,"text":"Déan do chuidse oibre."},
  {"section":"8.3.4","page":135,"text":"Mhill sé a chuidsean gruaige."},
  {"section":"8.3.4","page":135,"text":"Is é ár gcuidne airgid é."},
  {"section":"8.3.4","page":135,"text":"An bhfaca tú mo chinnse?"},
  {"section":"8.3.5","page":135,"text":"do m’ainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"dár n-ainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"do mo thástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"dár dtástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"do d’ainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"do bhur n-ainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"do do thástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"do bhur dtástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"á ainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"á n-ainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"á thástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"á dtástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"á hainmniú","phrase":true},
  {"section":"8.3.5","page":135,"text":"á tástáil","phrase":true},
  {"section":"8.3.5","page":135,"text":"Ná bí do mo chéasadh!"},
  {"section":"8.3.5","page":135,"text":"An bhfuil an obair á déanamh agaibh?"},
  {"section":"8.3.5","page":135,"text":"Bhí sé dár gcuardach."},
  {"section":"8.3.6","page":135,"text":"Bhí carr ag mo mháthair nuair a bhí sí óg."},
  {"section":"8.3.6","page":135,"text":"Ar thug tú bronntanas do do mháthair?"},
  {"section":"8.3.6","page":135,"text":"Cad a thug tú do d’athair?"},
  {"section":"8.3.6","page":135,"text":"Bhí hata ar a cheann."},
  {"section":"8.3.6","page":135,"text":"Bhí caipín ar a ceann."},
  {"section":"8.3.6","page":135,"text":"Tugadh an t-uisce as ár dtobarna."},
  {"section":"8.3.6","page":135,"text":"An grianghraf de bhur dteach é?"},
  {"section":"8.3.6","page":135,"text":"Tá siad géar as a mbarr."},
  {"section":"8.3.7","page":136,"text":"Bhain sé an hata dá cheann."},
  {"section":"8.3.7","page":136,"text":"Bhain sí an hata dá ceann."},
  {"section":"8.3.7","page":136,"text":"Bhain siad na hataí dá gceann."},
  {"section":"8.3.7","page":136,"text":"Thug sé dá athair é."},
  {"section":"8.3.7","page":136,"text":"Thug sí dá hathair é."},
  {"section":"8.3.7","page":136,"text":"Thug siad dá n-athair é."},
  {"section":"8.3.7","page":136,"text":"Scaoileamar dár ngreim."},
  {"section":"8.3.7","page":136,"text":"Thugamar dár n-aintíní iad."},
  {"section":"8.3.8","page":136,"text":"Fuair sé inár gcarr é."},
  {"section":"8.3.8","page":136,"text":"Labhair sé faoina mhac."},
  {"section":"8.3.8","page":136,"text":"Beidh mé ann faoina sé a chlog."},
  {"section":"8.3.8","page":136,"text":"Beidh an scannán ar siúl óna ceathair a chlog."},
  {"section":"8.3.8","page":136,"text":"Fuair sé ardmholadh trína fheabhas a rinne sé an obair."},
  {"section":"8.3.8","page":136,"text":"Ní raibh mé sásta lena fhad a thóg sé."},
  {"section":"8.3.8","page":137,"text":"a lán","phrase":true},
  {"section":"8.3.8","page":137,"text":"a leithéid","phrase":true},
  {"section":"8.3.8","page":137,"text":"a thuilleadh","phrase":true},
  {"section":"8.3.8","page":137,"text":"Ceadófar post lánaimseartha ina leithéid de chás."},
  {"section":"8.3.8","page":137,"text":"Fuair sí billí óna lán siopadóirí."},
  {"section":"8.3.8","page":137,"text":"Sin an t-áras ina seolfar an leabhar."},
  {"section":"8.3.8","page":137,"text":"Cuir ríomhphost chugam faoina bhfuil socraithe agat."},
  {"section":"8.3.8","page":137,"text":"Chuaigh sí go dtí a teach tar éis na hoibre."},
  {"section":"8.3.8","page":137,"text":"Ní dheachamar go dtí ár gcóisir féin."},
  {"section":"8.3.8","page":137,"text":"Níor thosaigh an léacht go dtí a cúig a chlog."},
  {"section":"8.3.8","page":137,"text":"Bhíomar ann go dtí a dó dhéag."},
  {"section":"8.3.9","page":137,"text":"leabhar arna eisiúint","phrase":true},
  {"section":"8.3.9","page":137,"text":"tuarascáil arna seoladh","phrase":true},
  {"section":"8.3.9","page":137,"text":"doiciméid arna bhfoilsiú","phrase":true},
  {"section":"8.3.9","page":137,"text":"Measfar é a bheith arna thoghadh faoin Acht seo."},
  {"section":"8.3.9","page":137,"text":"Ciallaíonn “Cúirt Chuarda” an Chúirt Chuarda arna bunú le dlí."},
  {"section":"8.3.9","page":137,"text":"Déanfar é faoi réir rialacháin arna ndéanamh faoi fho-alt 7."},
