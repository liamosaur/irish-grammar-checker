  {"section":"8.6.1","page":140,"text":"chomh mór siúd","phrase":true,"variant":true},
  {"section":"8.6.2","page":140,"text":"B’eo an áit."},
  {"section":"8.6.2","page":140,"text":"Ní heo é an leabhar."},
  {"section":"8.6.2","page":140,"text":"Nach eo é mo chótasa?"},
  {"section":"8.6.2","page":140,"text":"B’in é é."},
  {"section":"8.6.2","page":140,"text":"Ní hin mar a bheadh an cás."},
  {"section":"8.6.2","page":140,"text":"Dúirt sí gurb in é an fear."},
  {"section":"8.6.2","page":140,"text":"B’iúd iad ag imeacht ar cosa in airde."},
  {"section":"8.6.2","page":140,"text":"Is dócha gurbh iúd é é."},
  {"section":"8.6.2","page":140,"text":"An iúd iad na comharsana?"},
  {"section":"8.6.3","page":140,"text":"Is éard is cúram dúinne airgead a thabhairt ar iasacht."},
  {"section":"8.6.3","page":140,"text":"Ba éard a bhí mé a rá go mbeidh sé críochnaithe go luath."},
  {"section":"8.6.3","page":140,"text":"Shílfeadh duine gurb éard atá á chur i gcéill agat ná go ndearnadh d’aon ghnó é."},
  {"section":"8.6.3","page":140,"text":"An éard atá beartaithe foirgneamh nua a thógáil ann?"}
]
